<Page
    x:Class="XAU.Views.Pages.ScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XAU.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="ScannerPagen"
    Title="Scanner Page"
    d:DataContext="{d:DesignInstance local:ScannerPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Status card  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding ViewModel.PlayersFileStatusText}" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,0,4"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.NextScanText}" />

                <TextBlock
                    Grid.Row="2"
                    Margin="0,0,0,4"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.LastScanText}" />

                <TextBlock
                    Grid.Row="3"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap">
                    <Run Text="Output folder: " />
                    <Hyperlink Click="OutputPathHyperlink_OnClick">
                        <Run Text="{Binding ViewModel.OutputPath, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>

        <!--  Buttons row  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel
                Margin="15"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="170"
                    Margin="0,0,10,0"
                    Command="{Binding ViewModel.StartScanCommand}"
                    Content="Iniciar Scanner Agora"
                    Icon="{ui:SymbolIcon Play24}"
                    IsEnabled="{Binding ViewModel.CanStartScan}" />
                <ui:Button
                    MinWidth="120"
                    Margin="0,0,10,0"
                    Command="{Binding ViewModel.StopScanCommand}"
                    Content="Parar Scanner"
                    Icon="{ui:SymbolIcon Stop24}"
                    IsEnabled="{Binding ViewModel.IsScanning}" />
                <ui:Button
                    MinWidth="150"
                    Margin="0,0,10,0"
                    Command="{Binding ViewModel.OpenOutputFolderCommand}"
                    Content="Abrir pasta csv/"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
                <ui:Button
                    MinWidth="150"
                    Command="{Binding ViewModel.OpenPlayersFileCommand}"
                    Content="Abrir players.txt"
                    Icon="{ui:SymbolIcon DocumentEdit24}" />
            </StackPanel>
        </Border>

        <!--  Progress card (visible only while scanning)  -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,10"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding ViewModel.ScanProgressVisibility}">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding ViewModel.CurrentPlayerProgressText}" />

                <ProgressBar
                    Grid.Row="1"
                    Height="6"
                    Margin="0,0,0,6"
                    Maximum="{Binding ViewModel.TotalPlayers}"
                    Minimum="0"
                    Value="{Binding ViewModel.ProgressoCurrent, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="2"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.StatusMessage, StringFormat='Status: {0}'}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!--  Log output  -->
        <Border
            Grid.Row="3"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="5,0,5,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="Log" />

                <ListBox
                    x:Name="LogListBox"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="12"
                    ItemsSource="{Binding ViewModel.LogLines}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding}"
                                TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Page>
